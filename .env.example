# Copy to .env.local and fill in actual values.
# .env.local is gitignored — never commit it.

# ─── LLM Provider ───────────────────────────────────────────
# gemini | claude
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, only if comparing with Claude
ANTHROPIC_API_KEY=

# ─── Naver Search API (지역검색) ────────────────────────────
# https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── Naver Maps API (NCP) ──────────────────────────────────
# https://console.ncloud.com → Maps
# NEXT_PUBLIC_ prefix: exposed to browser (required for map JS)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ─── Supabase ──────────────────────────────────────────────
# https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma connection.
#
#   로컬 개발(local dev): Session pooler — port 5432
#     postgresql://postgres.<REF>:<PW>@aws-1-<REGION>.pooler.supabase.com:5432/postgres
#
#   서버리스 배포(Vercel 등): Transaction pooler — port 6543, ?pgbouncer=true&connection_limit=1
#     postgresql://postgres.<REF>:<PW>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# 비밀번호에 특수문자(!, @ 등) 있으면 URL 인코딩 (! → %21).
DATABASE_URL=

# ─── App ───────────────────────────────────────────────────
# 로컬: http://localhost:3000
# 배포 후: https://your-project.vercel.app (Vercel에서 자동 발급)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── 임시 공유 로그인 (Phase 6 에서 Supabase Auth 로 교체 예정) ────
# 둘 다 설정하면: 정확한 사용자명+비밀번호 입력해야 통과 (공유 자격증명)
# APP_PASSWORD 만 설정하면: 아무 사용자명 + 비밀번호 일치만 검증
# 둘 다 비우면: 잠금 해제 (로컬 개발용)
APP_USERNAME=
APP_PASSWORD=
